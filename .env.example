# Backend (Spring Boot)
# Local database from `supabase start`. Production DB values live only on Cloud Run.
DB_URL=jdbc:postgresql://127.0.0.1:54322/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# At least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change_me
JWT_EXPIRATION_HOURS=2160

GEMINI_API_KEY=your_gemini_api_key
# Optional, defaults to gemini-3.5-flash-lite (free tier: ~500 requests/day;
# gemini-3.5-flash is better but only ~20/day unless billing is on)
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional, AI calls per user per day (default 50)
# AI_DAILY_LIMIT=50

# Comma-separated origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:8080/api

